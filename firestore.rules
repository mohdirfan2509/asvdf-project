rules_version = '2';

// The website reads and writes Firestore only from its server, through the Firebase Admin SDK,
// which these rules do not apply to. Browsers never need direct access, so all of it is denied.
// Paste into Firebase Console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
